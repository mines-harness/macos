# mines uses its own identity and device-control services. No upstream account,
# relay, update feed, telemetry destination, or signing team is enabled by default.
# Copy to .env and fill only the settings you operate. Never commit secret keys.

# Self-hosted account and device service. Configure identically for every client.
# Keep server database, authentication secret, and SMTP credentials on the service.
# MINES_HOSTED_APP_URL=https://mines.example.com
# MINES_CONTROL_URL=https://mines.example.com
# MINES_STUN_URL=stun:mines.example.com:3478

# Isolated local state. Never point this at an existing T3 installation.
# MINES_HOME=/absolute/path/to/mines-data

# Separate distribution infrastructure. Updates stay disabled until configured.
# MINES_DESKTOP_UPDATE_REPOSITORY=your-organization/mines
# CLI/server updates and SSH installs are disabled without an own release source.
# MINES_CLI_UPDATE_REPOSITORY=your-organization/mines
# MINES_CLI_RELEASE_BASE_URL=https://releases.example.com/mines/download
# EXPO_PUBLIC_MINES_CLI_UPDATE_REPOSITORY=your-organization/mines
# VITE_MINES_DOWNLOAD_URL=https://example.com/mines/download
# MINES_EAS_PROJECT_ID=
# MINES_EAS_OWNER=
# MINES_MOBILE_UPDATES_ENABLED=1

# Signing identities must belong to the mines distributor.
# MINES_APPLE_TEAM_ID=
# MINES_APPLE_TEAM_ID=
# MINES_MACOS_PROVISIONING_PROFILE=/absolute/path/to/mines.provisionprofile

# Generic agent alerts: host opt-in and an own Expo project with APNs/FCM credentials.
# The Expo access token belongs only on the OVH control service, never in a client build.
# MINES_ANDROID_GOOGLE_SERVICES_FILE=/absolute/path/to/mines-google-services.json
# MINES_PUSH_ENABLED=1
# MINES_EXPO_PUSH_ACCESS_TOKEN=

# Optional public website release links. Leave unset until mines releases are published.
# PUBLIC_MINES_RELEASES_URL=https://github.com/your-organization/mines/releases/latest
# PUBLIC_MINES_NIGHTLY_RELEASES_URL=https://github.com/your-organization/mines/releases/tag/nightly
